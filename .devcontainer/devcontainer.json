{
  "name": "Ubuntu Docker-in-Docker Environment",
  
  // Uses the official Microsoft Ubuntu Devcontainer image as the host operating system
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu", 
  
  // Standard tool integrations provided by GitHub/Microsoft 
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": false
    }
  },
  
  // Ensures you operate with standard privileges inside your Ubuntu shell
  "remoteUser": "codespace"
}
